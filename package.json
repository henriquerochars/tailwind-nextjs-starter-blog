{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "start": "yarn dev",
    "dev": "contentlayer2 build && next dev --webpack",
    "build": "contentlayer2 build && next build --webpack && node scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true yarn build",
    "lint": "yarn lint:check",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "contentlayer2 build && next typegen && tsc --noEmit",
    "hooks:install": "husky"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.4.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "contentlayer2": "0.5.8",
    "github-slugger": "2.0.0",
    "next": "16.4.0",
    "next-contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "pliny": "0.4.1",
    "postcss": "8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@svgr/webpack": "8.1.0",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "24.x"
  }
}
