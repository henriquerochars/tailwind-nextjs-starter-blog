{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "start": "next dev --webpack",
    "dev": "cross-env INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env INIT_CWD=$PWD next build --webpack && node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:generated": "test -f .contentlayer/generated/index.mjs && test -f app/tag-data.json && test -f public/search.json && test -f public/feed.xml",
    "test:e2e": "yarn build && playwright test",
    "test:e2e:ci": "playwright test"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "esbuild": "0.18.11",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "1.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0",
    "contentlayer2": "0.5.8",
    "next-contentlayer2": "0.5.8",
    "@tailwindcss/postcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "yarn eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "yarn prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": "24.x"
  }
}
